{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "src", // baseUrl を "src" に設定
    "paths": {
      "@/*": ["./*"] // このように設定
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/page.tsx",
    "src/app/layout.jsx",
    "src/app/index/Page.jsx",
    "src/app/index/page.jsx",
    "src/app/about/aboutParts/page.jsx",
    "src/app/about/page.jsx",
    "src/app/about/aboutParts/aboutWhy.jsx"
  ],
  "exclude": ["node_modules"]
}
